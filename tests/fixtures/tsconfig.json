{
	"compilerOptions": {
		"baseUrl": ".",
		"strict": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./*"],
			"@test-types/*": ["./types/*"],
			"@app-services/*": ["./services/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx"]
}
