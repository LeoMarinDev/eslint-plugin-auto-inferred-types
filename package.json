{
    "name": "eslint-plugin-auto-inferred-types",
    "version": "0.1.0",
    "description": "ES Lint Plugin Auto Inferred Types",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "typescript",
        "typedef",
        "auto-inferred-types"
    ],
    "peerDependencies": {
        "@typescript-eslint/utils": "^8.65.0",
        "eslint": ">=10.0.0",
        "typescript": "^6.0.0"
    },
    "scripts": {
        "lint:fix": "eslint . --fix",
        "build": "tsup",
        "prepublishOnly": "npm run build",
        "test": "npm run build && mocha --forbid-only -R progress -t 10000 -c \"tests/lib/**/*.js\""
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.0",
        "@eslint/js": "^10.0.0",
        "@types/node": "^26.1.2",
        "@typescript-eslint/parser": "^8.66.0",
        "eslint": "^10.8.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "globals": "^17.9.0",
        "mocha": "^11.8.0",
        "sinon": "^22.1.0",
        "ts-morph": "^28.0.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0"
    }
}
