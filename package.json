{
    "name": "eslint-plugin-auto-inferred-types",
    "version": "0.1.1",
    "description": "ESLint plugin that detects missing type annotations in TypeScript and autofixes them from the compiler's type inference, including auto-import of referenced types",
    "license": "MIT",
    "author": {
        "name": "Leo Marinchenko",
        "url": "https://github.com/LeoMarinDev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LeoMarinDev/eslint-plugin-auto-inferred-types.git"
    },
    "homepage": "https://github.com/LeoMarinDev/eslint-plugin-auto-inferred-types#readme",
    "bugs": {
        "url": "https://github.com/LeoMarinDev/eslint-plugin-auto-inferred-types/issues"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "package.json"
    ],
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "typescript",
        "typedef",
        "auto-inferred-types"
    ],
    "peerDependencies": {
        "@typescript-eslint/utils": "^8.65.0",
        "eslint": ">=10.0.0",
        "typescript": "^6.0.0"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "lint:fix": "eslint . --fix",
        "build": "tsup",
        "prepublishOnly": "npm run build",
        "test": "npm run build && mocha --forbid-only -R progress -t 10000 -c \"tests/lib/**/*.js\""
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.0",
        "@eslint/js": "^10.0.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@typescript-eslint/parser": "^8.66.0",
        "eslint": "^10.8.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-auto-inferred-types": "^0.1.1",
        "eslint-plugin-import-x": "^4.17.1",
        "globals": "^17.9.0",
        "mocha": "^11.8.0",
        "sinon": "^22.1.0",
        "ts-morph": "^28.0.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0"
    },
    "funding": {
        "type": "custom",
        "url": "https://brainybuilds.com/"
    },
    "publishConfig": {
        "access": "public"
    }
}
