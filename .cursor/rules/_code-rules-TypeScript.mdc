function checkExists(
	value: unknown,
): boolean {
	let exists: boolean = false;

	if (
		value !== null
		&& value !== undefined
	) {
		exists = true;
	}

	return exists;
}

function checkExistsNot(
	value: unknown,
): boolean {
	let existsNot: boolean = false;

	if (
		value === null
		|| value === undefined
	) {
		existsNot = true;
	}

	return existsNot;
}
```

