### Exports

- **Prefer named exports** (`export function foo`, `export const BAR`, `export { foo, bar }`) over `export default`. Named exports are always refactorable - rename in one place, and the language service updates all import sites.
- **Use `export default`** only when a framework or build tool requires it (Next.js `page.tsx` / `layout.tsx` / `route.ts`, `robots.ts`, `sitemap.ts`, Payload admin pages, PostCSS config, ESLint config). No inline comment is required when the framework convention is obvious from the file path.
- **Handler and service modules** (`./src/handlers/**`, `./src/services/**`, `./src/config/**`, `./src/types/**`): either group all module-level exports at the bottom in a single `export { … }` block, or export each declaration inline at its definition - do not mix both styles in the same file.
- **Framework entry files** must use inline exports at declaration. Canonical Next.js App Router examples:

```ts
export const revalidate: number = 3600;

export async function generateMetadata(
	props: HomePageProps,
): Promise<Metadata> {
	// ...
}

function HomePage(
	props: HomePageProps,
): JSX.Element {
	// ...
}

export default HomePage;
```

- **Do not create barrel `index.ts` re-export files** unless a package boundary genuinely requires a stable public API surface. Re-export files that exist only for convenience hide dependency structure and slow down the TypeScript language service on large codebases.

```ts
// Named inline exports on declarations (preferred for types and config)
export const MAX_RETRY_COUNT: number = 3;
export interface RetryParams {
	maxRetries: number;
	delayMs: number;
}

// Named grouped export block at the bottom of a handler module
export {
	handleFetchUserDataV04,
	handlePushUserDataV04,
	handleSoftDeleteUserDataV04,
};
```

## Object and Array Destructuring

Use destructuring to improve clarity.

### Object Destructuring:
```ts
// file: ./src/types/dynamic-sql/fetch-user-types.ts (exports request body referenced by handlers)
export interface HandleFetchUserDataBody {
	schemaName: string;
	tableName: string;
	fetchColumns: FetchColumnsParams;
	bbox: BoundingBox;
	orderByParams: OrderByParams;
	limitParams: LimitParams;
}

// file: ./src/config/pg/column-fetch.ts (exports static table / column name literals)
export const PG_TABLE_USERS: string = "users";
export const FETCH_COLUMN_USER_ID_DIRECT: string = "id";
export const FETCH_COLUMN_USER_ID_FK: string = "user_id";

// file: `./src/handlers/db/handle-fetch-user-data-v04.ts` (imports types + configuration literals)
import {
	getSchemaTableColumns,
	type ColumnsSchema,
	type RowsByIdMapSerialized,
} from "@dynamic-sql-builder/index.core";

import {
	dbFetchDataRLS,
} from "@db-handling/query-handler-rls";

import type {
	AuthContext,
	AuthenticatedUserDetails,
} from "@types-internal/auth/context-types";

import type {
	HandleFetchUserDataBody,
} from "@types-internal/dynamic-sql/fetch-user-types";

import {
	databaseNameSupabase,
} from "@environment/environment";

import {
	FETCH_COLUMN_USER_ID_DIRECT,
	FETCH_COLUMN_USER_ID_FK,
	PG_TABLE_USERS,
} from "@config/pg/column-fetch";

async function handleFetchUserDataV04(
	context: AuthContext,
): Promise<RowsByIdMapSerialized> {
	// Object Destructuring
	const {
		body,
		store,
	}: AuthContext = context;

	const auth: AuthenticatedUserDetails = store.auth;
	// Object Destructuring and Renaming
	const {
		jwtOriginalPayload: jwtPayload,
		id: userId,
	}: AuthenticatedUserDetails = auth;

	const schemaName: string = body.schemaName;
	// Object Destructuring
	const {
		tableName,
		fetchColumns,
		bbox,
		orderByParams,
		limitParams,
	}: HandleFetchUserDataBody = body;

	const columnsSchema: ColumnsSchema = getSchemaTableColumns({
		databaseName: databaseNameSupabase,
		schemaName,
		tableName,
	});

	let columnNameUserId: string;
	if (
		tableName === PG_TABLE_USERS
	) {
		columnNameUserId = FETCH_COLUMN_USER_ID_DIRECT;
	} else {
		columnNameUserId = FETCH_COLUMN_USER_ID_FK;
	}
	fetchColumns[columnNameUserId] = {
		whereValue: userId,
	};

	const userData: RowsByIdMapSerialized = await dbFetchDataRLS({
		jwtPayload,
		schemaName,
		tableName,
		columnsSchema,
		fetchColumnsParams: fetchColumns,
		bbox,
		orderByParams,
		limitParams,
	});

	return userData;
}
```

### Array Destructuring:
```ts
// file: ./src/types/scheduling/time-window-types.ts (exports dual-window record + tuple alias)
export interface DualTimeWindows {
	windowsA: TimeWindows;
	windowsB: TimeWindows;
}

// file: ./src/scheduling/intersect-time-windows.ts (imports `DualTimeWindows` + array helpers)
import type {
	DualTimeWindows,
	TimeWindows,
	TimeWindow,
} from "@types-internal/scheduling/time-window-types";

function intersectTimeWindows(
	dualTimeWindows: DualTimeWindows,
): TimeWindows {
	// Object Destructuring
	const {
		windowsA,
		windowsB,
	}: DualTimeWindows = dualTimeWindows;

	const intersected: TimeWindows = [];

	let indexA: number = 0;
	let indexB: number = 0;

	while (
		indexA < windowsA.length
		&& indexB < windowsB.length
	) {
		// Array Destructuring
		const [
			startA,
			endA,
		]: TimeWindow = windowsA[indexA];
		// Array Destructuring
		const [
			startB,
			endB,
		]: TimeWindow = windowsB[indexB];

		const startMax: number = Math.max(
			startA,
			startB,
		);
		const endMin: number = Math.min(
			endA,
			endB,
		);

		if (
			startMax < endMin
		) {
			intersected.push([
				startMax,
				endMin,
			]);
		}

		if (
			endA < endB
		) {
			indexA += 1;
		} else {
			indexB += 1;
		}
	}

	return intersected;
}
```

## TypeScript Types

### Types and interfaces architecture

- **Declare and define** reusable **`interface`** and **`type` alias** declarations **only** under **`./src/types/**/*.ts`**, grouped by **module** and mirrored in the file name (for example **`./src/types/auth/auth-JWT-types.ts`** for auth-related JWT shapes).
- **Import** those names with **`import type { … }`** (or mixed **`import { type … }`**) via the **`@types-internal/…`** alias (for example **`@types-internal/auth/auth-JWT-types`**). Register **`@types-internal/*`** in **`compilerOptions.paths`** together with **`@config/*`** and your other roots (see **Always Use ES6 Module Syntax, Import Order, and Type Imports**).
- Cover **domain data structures**, **function parameter and return shapes**, **class-related types**, unions, literals, and any other **named compile-time shapes** shared by the team in those modules. **Do not** add parallel **`interface` / `type`** declarations in **`./src/handlers/**`**, **`./src/services/**`**, or arbitrary feature folders. **Never** keep production **`interface`/`type`** definitions outside **`./src/types/**`**.
- **For React component types** (`./src/types/components/**`): files are generalized per feature group - do not create one type file per component; create one per group because types are reused within a component group. Use **`PascalCase`** for the directory and the file prefix, appending **`-types`** (e.g., `./src/types/components/UserProfile/UserProfile-types.ts` covers all `UserProfile` components). See **code-rules-TypeScript-React-Tailwind.md** for full React component file naming rules.
- Prefer **`interface`** for reusable **object** shapes where it fits; use a **`type` alias** when **`interface` cannot express the shape** (for example unions of object types, discriminated unions whose members differ, tuples, mapped types, conditional types, or intersections that do not map cleanly to a single **`interface`** declaration).
- **Inline anonymous object types** in bindings (for example **`const { … }: { … } = …`**) remain acceptable **only** for **single-use**, **non-exported** local annotations, formatted per **Inline object types (annotations)** in **Multiline Formatting**; introduce a **`type`/`interface`** under **`./src/types/**`** as soon as a shape repeats, leaves the module, or names a stable domain concept.

### Primitives (`string`, `number`, `boolean`)

TypeScript includes all JavaScript's primitive types.

**Always** write an explicit **`: string`**, **`: number`**, or **`: boolean`** on **function parameters**, **locals**, and **`const` / `let` bindings** when the stored value is that primitive. Do **not** rely on type inference for primitives.

### Interfaces, classes, and `type` aliases

**Always** make the **named shape** visible at the binding: use an explicit **`interface`**, **`type` alias**, or **class** reference on the variable or on a **typed destructuring pattern** (for example **`const { a, b }: MyDto = dto`**), with **`interface`/`type`** definitions living under **`./src/types/**`** per **Types and interfaces architecture**. Prefer **`interface`** for reusable object shapes where it fits; reach for **`type`** when **`interface` cannot express the shape** (see **Types and interfaces architecture**). A **one-off inline object type** is acceptable only when the shape is not reused; write it **multiline** (**`{`** alone; **each** **`member: …;`** on its **own physical line**; **`}`** alone before **`=`**/`:`/`as`/`)`) per **Inline object types (annotations)** in **Multiline Formatting**. Otherwise introduce a **`type` alias** or **`interface`** in **`./src/types/**`. If a value is **only** primitives and does not carry a named domain type, the **primitive annotations** above suffice.

```ts
// file: ./src/config/time/duration-factors.ts (exports fixed multipliers referenced by latency math)
export const SECONDS_IN_MINUTE: number = 60;

// file: ./src/services/example-runtime-path.ts (imports primitive usage sample)
import {
	SECONDS_IN_MINUTE,
} from "@config/time/duration-factors";

const MINUTES: number = 30;

const secondsMaxThreshold: number = MINUTES * SECONDS_IN_MINUTE;
const duration: number = performance.now() - startTime;
const path: string = new URL(originalRequest.url).pathname;

const isValidBbox: boolean = validateBoundingBox(
	bbox,
);
```

### Arrays (`T[]` or `Array<T>`)

Give every array-valued binding an explicit element type (**`T[]`** or **`Array<T>`**) so composites stay as visible as primitives.

Annotate arrays:

```ts
// file: `./src/handlers/demo-weekdays-binding.ts` - imports weekday union annotated on the array binding
import type {
	Weekday,
} from "@types-internal/time/weekday-types";

const weekdays: Weekday[] = [
	"sunday",
	"monday",
	"tuesday",
	"wednesday",
	"thursday",
	"friday",
	"saturday",
];
```

### Optional and Union Types

Use a question mark (`?`) for optional properties, and the union operator (`|`) for multiple possible types:

```ts
// file: ./src/types/scheduling/mtsp-types.ts (exports optional-day + place records)
export interface OpenHours {
	monday?: TimeWindows | null;
	tuesday?: TimeWindows | null;
	wednesday?: TimeWindows | null;
	thursday?: TimeWindows | null;
	friday?: TimeWindows | null;
	saturday?: TimeWindows | null;
	sunday?: TimeWindows | null;
}

export interface MtspPlace {
	id: string;
	geometry: GeometryPoint;
	open_hours: OpenHours;
	tag_ids: number[];
	recommended_visit?: number;
}
```

### Literal Types and Type Inference

Literal types constrain a value to a finite set of strings or numbers. Whenever the domain is **bounded and known at design time**, prefer a **string literal union** over a plain `string` - TypeScript will reject any out-of-domain value at compile time and editors will autocomplete valid options. Declare these unions under `./src/types/**` per **Types and interfaces architecture**.

```ts
// file: ./src/types/time/weekday-types.ts
export type Weekday =
	| "sunday"
	| "monday"
	| "tuesday"
	| "wednesday"
	| "thursday"
	| "friday"
	| "saturday";

// file: ./src/types/routing/profile-types.ts
export type RoutingProfile =
	| "auto"
	| "pedestrian"
	| "bicycle";

// file: ./src/types/db/query-return-types.ts
export type DbReturnType =
	| "mapSerialized"
	| "map"
	| "array"
	| "object";
```

Use literal union types as parameter and field types so out-of-union values fail at compile time rather than silently at runtime:

```ts
// file: ./src/routing/example-routing-request.ts
import type {
	RoutingProfile,
} from "@types-internal/routing/profile-types";

function buildProfileUrl(
	profile: RoutingProfile,
): string {
	const url: string = `https://router.example.com/${profile}`;
	return url;
}

// buildProfileUrl("bike");  // compile error - "bike" is not assignable to RoutingProfile
// buildProfileUrl("auto");  // valid
```

For **`number | string`** style unions on a binding (still annotate primitives; use **`UPPER_CASE`** named constants for fixed protocol values):
```ts
// file: ./src/config/http/status-literals.ts (exports default status literal)
export const HTTP_STATUS_LITERAL: number = 200;

// file: ./src/http/example-request-context.ts (consumer; inline object types stay local per Multiline Formatting)
import {
	HTTP_STATUS_LITERAL,
} from "@config/http/status-literals";

const duration: number = performance.now() - startTime;
const {
	method,
}: {
	method: string;
} = originalRequest;
const path: string = new URL(originalRequest.url).pathname;
const statusCarrier: {
	status?: number | string;
} = {};

const status: number | string = statusCarrier.status ?? HTTP_STATUS_LITERAL;
```

### Type Assertions

Assertions appear where runtime validation already narrowed the truth, but TypeScript cannot prove it:
```ts
// file: `./src/auth/example-jwt-followup.ts` - imports payload contract from types
import type {
	JwtPayload,
} from "@types-internal/auth/auth-JWT-types";

// jwksRemote is a function that jose.jwtVerify will call to get the key
const {
	payload,
} = await jose.jwtVerify(
	token,
	jwksRemote,
	verifyOptions,
);

if (
	payload.sub === undefined
) {
	const jwtRejected: null = null;
	return jwtRejected;
}

// Validate essential claims after successful verification
const jwtPayload: JwtPayload = payload as JwtPayload;

const {
	sub: id,
	email,
}: JwtPayload = jwtPayload;
```

### `null` and `undefined` Checks

Use strict null checks enabled, always guard against `null` or `undefined`:
```ts
// file: `./src/config/database/default-schemas.ts`
export const DEFAULT_PG_SCHEMA: string = "public";

// file: ./src/types/gis/example-schema-guardrails-types.ts
import type {
	BoundingBox,
} from "@types-internal/gis/bbox";

export interface ExampleApplySchemaGuardrailsParams {
	databaseName: string;
	schemaName?: string | null;
	tableName: string;
	bbox?: BoundingBox | null;
}

// file: `./src/handlers/example-schema-guardrails.ts`
import {
	DEFAULT_PG_SCHEMA,
} from "@config/database/default-schemas";

import {
	getSchemaTableColumns,
} from "@dynamic-sql-builder/index.core";

import type {
	ColumnsSchema,
} from "@types-internal/dynamic-sql/columns-schema";

import type {
	ExampleApplySchemaGuardrailsParams,
} from "@types-internal/gis/example-schema-guardrails-types";

import {
	validateBoundingBox,
} from "@gis-validation/validate-bounding-box";

export function exampleApplySchemaGuardrails(
	params: ExampleApplySchemaGuardrailsParams,
): ColumnsSchema {
	const {
		databaseName,
		schemaName,
		tableName,
		bbox,
	}: ExampleApplySchemaGuardrailsParams = params;

	let schemaNameResolved: string;
	if (
		schemaName === undefined
		|| schemaName === null
	) {
		schemaNameResolved = DEFAULT_PG_SCHEMA;
	} else {
		schemaNameResolved = schemaName;
	}

	if (
		bbox !== undefined
		&& bbox !== null
	) {
		const isValidBbox: boolean = validateBoundingBox(
			bbox,
		);

		if (
			isValidBbox === false
		) {
			const invalidBboxError: Error = new Error(
				"Invalid bounding box: Coordinates are out of bounds or malformed.",
			);
			throw invalidBboxError;
		}
	}

	const columnsSchema: ColumnsSchema = getSchemaTableColumns({
		databaseName,
		schemaName: schemaNameResolved,
		tableName,
	});

	if (
		columnsSchema === undefined
		|| columnsSchema === null
	) {
		const missingTableError: Error = new Error(
			"Table or Schema does not exist.",
		);
		throw missingTableError;
	}

	return columnsSchema;
}
```

### Never Use `any` - Use `unknown` When Types Are Truly Erased

Never use **`any`**. Prefer **explicit Types**, **unions**, **intersections**, and **generics** so mistakes surface at compile time.

**Use `unknown`** (or **`Promise<unknown>`**, **`unknown[]`**, etc.) when values **cannot be known statically** until **runtime inspection** resolves them-for example **`response.json()`**, **incoming HTTP payloads before validation**, **`Record<string, unknown>`** from external systems, **message queues**, or **`process.env`-shaped blobs**. Narrow with **type guards**, **schema validators** (for example **Zod**), or **narrowing checks** immediately after ingestion; **`unknown`** is preferable to pretending you already hold a richer type.

**Avoid gratuitous `unknown`**-once you have validated shape, spell out concrete domain types downstream.

Example with **imported domain types** and a **string-literal union**:
```ts
// file: ./src/types/dynamic-sql/db-fetch-rows.ts (imports row shapes exported elsewhere before composing unions here)
import type {
	RowsByIdMapSerialized,
	RowsByIdMap,
	RowsArray,
	RowsById,
} from "@types-internal/dynamic-sql/rows-shapes";

export type DbFetchDataRows =
	RowsByIdMapSerialized
	| RowsByIdMap
	| RowsArray
	| RowsById;

export type DbFetchDataReturnType =
	| "mapSerialized"
	| "map"
	| "array"
	| "object";
```

### Declare object structures with `interface`

Name reusable object shapes as **`interface`** members declared under **`./src/types/**`** (members use **`;`** separators inside the body). This matches **Interfaces, classes, and `type` aliases** above: exported or shared shapes should be **`interface`** when practical (or a **`type` alias** when you need unions, mapped types, or any construct **`interface` cannot express**) so call sites can annotate with that name.

Example with **`interface`**, optional fields with `?`, and reused types:
```ts
// file: ./src/types/dynamic-sql/handlers-and-messages-types.ts - single module exporting multiple coherent records
export interface FetchData {
	databaseName: string;
	schemaName: string;
	tableName: string;
	fetchColumns: FetchColumnsParams;
	bbox: BoundingBox;
	orderBy?: OrderByParams;
	limit?: number;
}

export interface CreateSchedule {
	tableName: string;
	placesIds: string[];
	days: number;
	maxPlacesPerDay: number;
}

/**
 * @interface RequestLogState
 * @description Defines the structure for storing request - specific data in the context store.
 */
export interface RequestLogState {
	startTime: number;
	request: Request;
}

export interface GetTableSchema {
	databaseName?: string;
	schemaName?: string;
	tableName: string;
}

export interface ResponseMessage {
	success: boolean;
	message: string;
}
```

## Config Files

- **Declare and define** static behavioral values - tuning knobs, limits, literals shared across modules, protocol constants, path segments you own, feature flags, and other **behavioral configuration** - **only** under **`./src/config/**/*.ts`**, mirrored by module (for example **`./src/config/gis/coordinates.ts`**).
- **Import** configuration with the **`@config/…`** alias (for example **`@config/gis/coordinates`**). Register **`"@config/*": ["src/config/*"]`** in **`compilerOptions.paths`** (see **Always Use ES6 Module Syntax, Import Order, and Type Imports**).
- When values are truly **shared static configuration**, define them once under **`./src/config/**`** and **import** via **`@config/…`** inside **`function`** bodies; keep **`interface`/`type`** DTO declarations in **`./src/types/**`** with **primitive or structural fields** instead of repeating the same literals inline.
- **For React component config** (`./src/config/components/**`): files are generalized per feature group - do not create one config file per component; create one per group because config literals are reused within a component group. Use **`PascalCase`** for the directory and the file prefix, appending **`-config`** (e.g., `./src/config/components/UserProfile/UserProfile-config.ts`). See **code-rules-TypeScript-React-Tailwind.md** for full React component file naming rules.
- **Never** sprinkle freestanding **`export const SOME_LIMIT = …`** (or equivalent configuration) across services, helpers, or route files outside **`./src/config/**`; lift them into the proper **`./src/config/<module>/….ts`** file.
- **Config is not content**: user-facing rendered strings (labels, headings, button text, empty-state messages) belong in **`./src/content/**/*.ts`** (imported via **`@content/…`**), not in `./src/config/**`. Register **`"@content/*": ["src/content/*"]`** in **`compilerOptions.paths`**.
- **Config is not state logic**: pure state transition functions, reducers, action builders, and initial state builders belong in **`./src/states/**/*.ts`** (imported via **`@states/…`**), not in `./src/config/**`. Register **`"@states/*": ["src/states/*"]`** in **`compilerOptions.paths`**.
- **Config is not presentation styling**: reusable Tailwind class names belong in **`./src/styles/classNames/**/*.ts`** (imported via **`@classNames/…`**), not in `./src/config/**`. Register **`"@classNames/*": ["src/styles/classNames/*"]`** in **`compilerOptions.paths`**.

Example (**`./src/config/gis/coordinates.ts`**):

```ts
// file: ./src/config/gis/coordinates.ts
export const MIN_LATITUDE: number = -90;
export const MAX_LATITUDE: number = 90;
export const MIN_LONGITUDE: number = -180;
export const MAX_LONGITUDE: number = 180;
```

## Module Design

### One Responsibility per Module

Every **`*.ts`** module owns **exactly one primary concern**. Choose one concern type and do not mix it with another in the same file.

**Canonical concern types and their homes:**

- **Fetch / transport** (`./src/http/**`, `./src/services/**`): Issues I-O - HTTP requests, database queries, file reads. Returns a raw or typed response. Does not validate domain data, contain business rules, or transform output shapes.
- **Validate** (`./src/validation/**`, `./src/gis-validation/**`): Checks structural or domain invariants. Returns **`boolean`** or **`throw`**s a named **`Error`**. Does not fetch data or own data transformations.
- **Transform / map** (`./src/transform/**`, `./src/formatting/**`): Converts one data shape to another through pure logic. Does not perform I-O and does not validate.
- **Orchestrate** (`./src/handlers/**`, `./src/services/**`): Sequences fetch, validate, and transform operations by importing and calling them at named boundaries. Owns the workflow, not the individual operations.
- **Configure** (`./src/config/**`): Behavioral fixed literals and constants only. See **Config Files**. Does not contain user-facing rendered strings or state transition logic.
- **Define types** (`./src/types/**`): Compile-time shapes only. See **Types and interfaces architecture**.
- **Pure state transition logic** (`./src/states/**`): Reducers, state factories, action builders, initial state builders, derived selectors, reset helpers. No JSX. No React Hooks. No `Context` creation. Imported via `@states/…`. For React components, files are generalized per feature group using `PascalCase` directories and the `<FeatureGroup>-state.ts` naming pattern (e.g., `./src/states/Counter/Counter-state.ts`).
- **User-facing static content** (`./src/content/**`): Every hardcoded static value that renders as user-visible output - labels, headings, button text, descriptions, empty-state messages, nav text, pricing copy. Imported via `@content/…`. Never placed in `./src/config/**` or inlined in source files. For React components, files are generalized per feature group using `PascalCase` directories and the `<FeatureGroup>-content.ts` naming pattern (e.g., `./src/content/Counter/Counter-content.ts`).
- **UI view components** (`./src/components/**`): Each `.tsx` file declares and exports exactly one React component. A List component (`ComponentNameList.tsx`) orchestrates iteration and collection layout only; an Item component (`ComponentName.tsx`) renders a single data node and handles local item events. These two concerns must never be merged into one file. Both reside together in the same PascalCase feature directory (e.g., `./src/components/Notifications/`). See **code-rules-TypeScript-React-Tailwind.md** for full React component rules.
- **Reusable styling / Tailwind class strings** (`./src/styles/classNames/**`): Fixed Tailwind utility strings, exported as `UPPER_CASE` constants. Imported via `@classNames/…`. Files are named in `PascalCase` matching the component or feature group, appending `-classNames` (e.g., `Button-classNames.ts`, `Notification-classNames.ts`). Single-use `className` strings may remain inline in JSX; repeated class strings must be extracted here before their second use.

**Rules:**

- **Name each file after its single concern**: `fetch-matrix.ts` fetches; `validate-bounding-box.ts` validates; `map-routes.ts` transforms; `handle-get-matrix.ts` orchestrates.
- **Orchestrators compose** - they import and call fetch, validate, and transform functions at clearly named call sites. They do not re-implement those concerns inline.
- **Never** write HTTP I-O inside a validator or a transformer.
- **Never** embed domain validation inside a fetch function.
- **Never** scatter `export const SOME_LITERAL = …` in service or handler files; lift into `./src/config/**` (see **Config Files**).
- **When helpers accumulate spanning two concerns** (for example a module that both issues HTTP requests and transforms the response), that is the signal to split into two files and compose them in an orchestrator.
- **One component per `.tsx` file**: never declare the structure of both a collection orchestrator (`ComponentNameList`) and its individual items (`ComponentName`) in the same file. Extract the Item into its own `ComponentName.tsx` and have the List import it. When `ComponentName` is buried inside `ComponentNameList.tsx`, it cannot be independently tested or reused elsewhere, and a change to the Item's layout will always touch the List's orchestration code - a direct violation of SoC and Iterability.

The modules already illustrated in this document each demonstrate a single concern: `./src/http/fetch-request.ts` transports only (see **Use `async` and `await`**); `./src/gis-validation/validate-bounding-box.ts` validates only (see **Function Structure**); `./src/config/gis/coordinates.ts` configures only (see **Config Files**).

**Orchestrator composed from single-concern imports:**

```ts
// file: ./src/types/places/get-places-types.ts (exports request + result shapes)
import type {
	BoundingBox,
} from "@types-internal/gis/bbox";

import type {
	FetchColumnsParams,
} from "@types-internal/dynamic-sql/fetch-columns-types";

export interface GetPlacesParams {
	bbox: BoundingBox;
	jwtPayload: JwtPayload;
	schemaName: string;
	tableName: string;
	fetchColumns: FetchColumnsParams;
}

// file: ./src/services/places/get-places.ts (orchestrates: validate -> fetch -> return)
import type {
	GetPlacesParams,
} from "@types-internal/places/get-places-types";

import type {
	RowsByIdMapSerialized,
} from "@types-internal/dynamic-sql/rows-shapes";

import {
	validateBoundingBox,
} from "@gis-validation/validate-bounding-box";

import {
	dbFetchDataRLS,
} from "@db-handling/query-handler-rls";

async function getPlaces(
	params: GetPlacesParams,
): Promise<RowsByIdMapSerialized> {
	const {
		bbox,
		jwtPayload,
		schemaName,
		tableName,
		fetchColumns,
	}: GetPlacesParams = params;

	const isValidBbox: boolean = validateBoundingBox(bbox);

	if (
		isValidBbox === false
	) {
		const invalidBboxError: Error = new Error(
			"Invalid bounding box.",
		);
		throw invalidBboxError;
	}

	const places: RowsByIdMapSerialized = await dbFetchDataRLS({
		jwtPayload,
		schemaName,
		tableName,
		fetchColumns,
		bbox,
	});

	return places;
}
```

### Extract Repeated Logic (DRY)

When the **same logical step** - a guard, a normalization, a computation, or a data mapping - appears in **two or more places**, **extract it once** as a **named function** before writing it a second time. This applies equally within a single module and across modules.

**The trigger is duplication itself.** The moment you find yourself writing code that already exists somewhere else, stop and extract before pasting.

**Rules:**

- **Never paste duplicate blocks.** Duplicate logic across two call sites is a violation, regardless of how short the block is.
- **Name the extracted function clearly** after what it does: `resolveSchemaName`, `buildRequestUrl`, `normalizeTimestamp`. The name is the explanation.
- **Place the helper at module scope**, declared below its first caller, per **Files Structure - Function flow and ordering**. Never nest it inside another function's body (see **Named functions at module scope; no nested declarations**).
- **When a helper is needed by two or more modules**, move it to its own file in the appropriate subtree (`./src/validation/**`, `./src/transform/**`, `./src/http/**`, and so on) and import it via the matching alias. Do not copy it.
- **The same discipline applies to type shapes**: once an inline object type repeats or leaves the module, name it under `./src/types/**` instead of duplicating the annotation (see **Types and interfaces architecture** and **Inline object types (annotations)** in **Multiline Formatting**).

The extract-once rule and the module-scope placement rule are complementary: **Named functions at module scope; no nested declarations** tells you **where** helpers live; this rule tells you **when** to create them.

```ts
// file: ./src/types/db/schema-table-params-types.ts (exports request shapes for both handlers)
export interface FetchTableParams {
	schemaName?: string | null;
	tableName: string;
	fetchColumns: FetchColumnsParams;
	jwtPayload: JwtPayload;
}

export interface UpsertTableParams {
	schemaName?: string | null;
	tableName: string;
	rows: unknown[];
	jwtPayload: JwtPayload;
}

// file: ./src/services/db/multi-table-service.ts
import type {
	FetchTableParams,
	UpsertTableParams,
} from "@types-internal/db/schema-table-params-types";

import type {
	RowsByIdMapSerialized,
	UpsertResult,
} from "@types-internal/dynamic-sql/rows-shapes";

import {
	DEFAULT_PG_SCHEMA,
} from "@config/database/default-schemas";

import {
	dbFetchDataRLS,
	dbUpsertDataRLS,
} from "@db-handling/query-handler-rls";

// Both orchestrators call resolveSchemaName instead of repeating the guard block.
async function fetchTable(
	params: FetchTableParams,
): Promise<RowsByIdMapSerialized> {
	const {
		schemaName: schemaNameRaw,
		tableName,
		fetchColumns,
		jwtPayload,
	}: FetchTableParams = params;

	const schemaName: string = resolveSchemaName(schemaNameRaw);

	const rows: RowsByIdMapSerialized = await dbFetchDataRLS({
		jwtPayload,
		schemaName,
		tableName,
		fetchColumns,
	});

	return rows;
}

async function upsertTable(
	params: UpsertTableParams,
): Promise<UpsertResult> {
	const {
		schemaName: schemaNameRaw,
		tableName,
		rows,
		jwtPayload,
	}: UpsertTableParams = params;

	const schemaName: string = resolveSchemaName(schemaNameRaw);

	const result: UpsertResult = await dbUpsertDataRLS({
		jwtPayload,
		schemaName,
		tableName,
		rows,
	});

	return result;
}

// Extracted once at module scope, below both callers (per Files Structure - Function flow and ordering).
// If a third module needed this helper, it would move to ./src/db/resolve-schema-name.ts and be imported.
function resolveSchemaName(
	schemaName: string | null | undefined,
): string {
	let resolved: string;

	if (
		schemaName === undefined
		|| schemaName === null
	) {
		resolved = DEFAULT_PG_SCHEMA;
	} else {
		resolved = schemaName;
	}

	return resolved;
}
```

## Files Structure

### Imports

- **Every** **`*.ts`** module **starts with all `import`/`export type` declarations** grouped per **Always Use ES6 Module Syntax, Import Order, and Type Imports**; **imports precede** any **`function`**, **`class`**, or **`const`** implementation.

### Function flow and ordering inside a module

- **Top-to-bottom abstraction**: Order code so the file reads **from higher abstraction to lower**. After imports, place **orchestrators** (**handlers**, **drivers**, **managers**) **first**, then **narrow helpers** and **single-purpose utilities** **toward the bottom**. Avoid layouts where the entry flow is buried under helpers (a pattern sometimes seen in other ecosystems); the **primary story** should be readable **from the top down**. When the helpers tier spans two or more concern types (fetch helpers alongside transform helpers, for example), that is the signal to split the file into separate single-concern modules per **Module Design - One Responsibility per Module**.
- **File-local callees**: When **`function` A** in this module calls **`function` B** in the **same** file, define **B below A** so dependency direction matches reading order. Do **not** rely on **`function` hoisting** to call something declared **above** the callsite. If you need mutual recursion or an upward reference, **split** logic into another module and **`import`** it, or refactor so the callee sits lower.
- **Imported symbols** (`import`, **`import type`**) **may be referenced from anywhere** in the module; ordering rules apply to **`function`** declarations lexically scoped in **this** translation unit.

## Conditional Statements

Compound boolean conditions follow **Boolean predicates (all conditional uses)** under **Multiline Formatting** (**one operand or sub-condition per physical line** everywhere such a predicate appears).

### Strict Equality

- Always use explicit checks (`===` and `!==`)
- Never use loose checks (`==` or `!=`)
```ts
function checkExists(
	value: unknown,
): boolean {
	let exists: boolean = false;

	if (
		value !== null
		&& value !== undefined
	) {
		exists = true;
	}

	return exists;
}

function checkExistsNot(
	value: unknown,
): boolean {
	let existsNot: boolean = false;

	if (
		value === null
		|| value === undefined
	) {
		existsNot = true;
	}

	return existsNot;
}
```

### `switch` Statements

Use `switch` when branching on a **discriminated union** or a **string literal union** - the compiler verifies exhaustiveness via the `default` branch, so any unhandled variant surfaces at review time rather than silently at runtime.

**Rules:**

- Wrap every `case` body in `{ }` braces so variable declarations stay scoped to the branch.
- **Always** include a `default` branch. In an exhaustive switch over a known union, let `default` throw a named `Error` to surface any variant that slips through (per **Return defined variables** and **Error handling with `try…catch`**).
- **Never** fall through from one `case` to the next (no missing `break` or `return`). Each `case` block must end with a `return`, a `throw`, or a `break`.
- Per **Return defined variables**, every `return` inside a `switch` still assigns to a named binding first, then returns that binding.

```ts
// file: ./src/types/db/query-return-types.ts
export type DbReturnType =
	| "mapSerialized"
	| "map"
	| "array"
	| "object";

// Exhaustive switch - canonical shape (see also Error handling with try...catch)
switch (returnType) {
	case "mapSerialized": {
		const rowsByIdMapSerialized: RowsByIdMapSerialized = convertRowsToMapIdSerialized(
			rowsArray,
		);
		return rowsByIdMapSerialized;
	}
	case "map": {
		const rowsByIdMap: RowsByIdMap = convertRowsToMapId(
			rowsArray,
		);
		return rowsByIdMap;
	}
	case "array": {
		return rowsArray;
	}
	case "object": {
		const rowsById: RowsById = convertRowsToObjectId(
			rowsArray,
		);
		return rowsById;
	}
	default: {
		const unknownReturnTypeError: Error = new Error(
			"Unknown returnType value",
		);
		throw unknownReturnTypeError;
	}
}
```

### Ternary Operator

A ternary (`condition ? valueA : valueB`) is acceptable **only** when all three conditions hold:

1. Both branches are **single tokens** - identifiers, simple literals, or a single named function call.
2. The result is **assigned to a named binding** (never used as a bare statement for side effects).
3. The expression is **not nested** inside another ternary.

**Never** nest ternaries. **Never** use a ternary as a statement. When a branch needs computation or multi-step logic, use `if`/`else` and assign to a `let` binding instead.

```ts
// Acceptable - single-token branches, result assigned to a named binding
const schemaName: string = (
	rawSchema !== null
		? rawSchema
		: DEFAULT_PG_SCHEMA
);
```

### Early Returns (Guard Clauses)

Use **early returns** at the beginning of a function body to reject invalid inputs or boundary conditions before any real work begins. This keeps the main logic at shallow nesting and makes the happy path easy to follow.

**Rules:**

- Place guard-clause returns in the **Data layer** of the function body (see **Function Structure**).
- Each early `return` must follow **Return defined variables**: assign to a binding, then return that binding.
- Each early `throw` must follow the same rule: assign `new Error(…)` to a `const`, then throw that identifier.
- Do not guard-clause in the middle of the Operation layer; move such checks earlier or extract a named validator.

```ts
// file: ./src/types/gis/validate-bbox-params-types.ts
export interface ValidateBboxParams {
	bbox: BoundingBox | null | undefined;
}

// Guard clauses in the Data layer reject invalid input before business logic runs.
function validateAndGetBbox(
	params: ValidateBboxParams,
): BoundingBox {
	const {
		bbox,
	}: ValidateBboxParams = params;

	// Guard clause - early rejection in the Data layer
	if (
		bbox === undefined
		|| bbox === null
	) {
		const missingBboxError: Error = new Error(
			"bbox is required but was not provided.",
		);
		throw missingBboxError;
	}

	// Operation layer - bbox is narrowed to BoundingBox here
	const isValid: boolean = validateBoundingBox(
		bbox,
	);

	if (
		isValid === false
	) {
		const invalidBboxError: Error = new Error(
			"Invalid bounding box: coordinates are out of bounds or malformed.",
		);
		throw invalidBboxError;
	}

	return bbox;
}
```


## Looping Constructs

### Classical index `for` loops (and `while`)

Prefer **`for` loops with an explicit initializer, condition, and update** (`for (let index = …; …; …)`) for counted iteration, instead of **`for…of`**, **`for…in`** as an array walker, or **`.map` / `.forEach` / `.filter`** when those methods exist only to visit each element (side effects or step-by-step `await`). **`while`** is permitted when loop control reads more clearly. **`while`** and **`do…while`** condition expressions follow **Boolean predicates (all conditional uses)** in **Multiline Formatting** the same way **`if`** does.

For example:

```ts
// file: `./src/types/vroom/vroom-day-types.ts`
export interface VroomDayParam {
	time_window: number[];
	max_places: number;
	max_travel_time: number;
}

// file: `./src/config/vroom/display.ts`
export const DISPLAY_INDEX_BASELINE: number = 1;

// file: `./src/routing/example-vroom-batch.ts`
import type {
	VroomDayParam,
	VroomVehicle,
} from "@types-internal/vroom/vroom-day-types";

import {
	DISPLAY_INDEX_BASELINE,
} from "@config/vroom/display";


for (
	let vehicleIndex: number = 0;
	vehicleIndex < vehiclesLength;
	vehicleIndex++
) {
	const daysParam: VroomDayParam = daysParams[vehicleIndex];
	const {
		time_window,
		max_places,
		max_travel_time,
	}: VroomDayParam = daysParam;

	const vehicle: VroomVehicle = getVroomVehicle({
		id: (vehicleIndex + DISPLAY_INDEX_BASELINE),
		profile,
		description: (vehicleIndex + DISPLAY_INDEX_BASELINE).toString(),
		start_index: 0,
		end_index: 0,
		time_window,
		max_tasks: max_places,
		max_travel_time,
	});

	vehicles.push(vehicle);
}
```

## Function Declarations

### Named functions at module scope; no nested declarations

- **Always** write durable, reusable behavior with **`function`** or **`async function`** (**named functions**) at **module scope** (or in another **`*.ts`** file), including helpers and module-private routines. **Do not** bind the module's main routines as **`const fn = (`…`) => …`** when a **`function`** declaration would work.
- **Never** write a **`function`** or **`async function`** nested **inside another function's body** (no inner **`function`** declarations and no **`const inner = function …`** inside a routine). Move the callee to **module scope** (typically **below** callers per **Files Structure - Function flow and ordering**) or **`import`** it. **`class`** methods remain valid for object-oriented APIs.
- **Callbacks are allowed**: Creating and **passing** an **arrow** or **anonymous function expression** **to an API** that expects a callback or iterator body (**`Promise`**, **`array.map`**, **`addEventListener`**, **`setTimeout`**, and similar) **is fine**. Those expressions **must not** replace a **`function`** that should live at module scope for clarity, reuse, or stack traces.
- **Extract when logic repeats**: if the same logical step appears in a second place anywhere in the codebase, extract it as a named module-scope function before writing it again. See **Extract Repeated Logic** in **Module Design**.

Named functions yield clearer stacks and searchable symbols:
```ts
import type {
	FetchDataBody,
	RowsByIdMapSerialized,
} from "@types-internal/sql/fetch-data-body-types";

// file: `./src/handlers/sql/handle-fetch-data-request-v04.ts`
async function handleFetchDataRequestV04(
	body: FetchDataBody,
): Promise<RowsByIdMapSerialized> {

	const {
		databaseName,
		schemaName,
		tableName,
		fetchColumns,
		bbox,
		orderBy,
		limit,
	} = body;

	// ... remainder follows Function Structure (Data / Operation / Return)
}
```

### Function Structure

Structure every **`function`** body as **three vertical bands** (**Data - Operation - Return**):

1. **Data layer** - gather everything the routine needs **before** heavy logic runs:
	1. **Parameter unpacking** (**destructuring**, defaults, typed bindings referencing shapes under **`./src/types/**`).
	2. **Guards**, **cheap validation**, **`const`** seeds, and **short** delegated calls meant to **normalize inputs** (**push** fuller workflows into the Operation layer below).
2. **Operation layer** - **business logic**, **mutations**, **branching**, **non-trivial delegated calls**.
	1. **Internal computations** (boolean combinators obey **Multiline Formatting**).
	2. **Calls into other named functions** (imported helpers or file-local helpers declared **lower** per **Files Structure**).
3. **Return** - **multiple `return` statements are allowed** (early exits, **`switch`** branches, guards). Each **`return`** must pass **a single identifier** (a **`const`**, **`let`**, or parameter name) that already holds the outgoing value (**Return defined variables**). **Do not** **`return` a composite expression**: no direct **`return`** of calls, **`await`**, arithmetic, **`&&` / `||`** stacks, object/array literals, template literals, or ternaries (**bind** the result first, then **`return`** the binding). The same rule applies to **`throw`**: **`throw` only** an identifier bound to an **`Error`** (or rethrow a bound variable). **Always** assign **`new Error(…)`** (including with a **`cause`**) to a **`const`** first, then **`throw`** that identifier (see **Error handling with `try…catch`**).

Example (**imports** **`@config`**, **`@types-internal`**, and a named **`areAllValuesNumbers`** helper):

```ts
// file: `./src/gis-validation/validate-bounding-box.ts`

import {
	MIN_LATITUDE,
	MAX_LATITUDE,
	MIN_LONGITUDE,
	MAX_LONGITUDE,
} from "@config/gis/coordinates";

import {
	BBOX_REQUIRED_LENGTH,
} from "@config/gis/bbox";

import type {
	BoundingBox,
} from "@types-internal/gis/bbox";

import {
	areAllValuesNumbers,
} from "@gis-validation/bbox-helpers";

function validateBoundingBox(
	bbox: BoundingBox,
): boolean {
	// Data layer start
	// 1. Destructure parameters
	const [
		minLon,
		minLat,
		maxLon,
		maxLat,
	]: BoundingBox = bbox;

	// 2. Data validation / lightweight checks on prepared values
	const isArrayLengthValid: boolean = (
		bbox.length === BBOX_REQUIRED_LENGTH
	);
	// Data layer end

	// Operation layer start
	const areAllNumbers: boolean = areAllValuesNumbers(
		bbox,
	);
	const areCoordinatesInBounds: boolean = (
		minLat >= MIN_LATITUDE
		&& maxLat <= MAX_LATITUDE
		&& minLon >= MIN_LONGITUDE
		&& maxLon <= MAX_LONGITUDE
		&& minLat < maxLat
		&& minLon < maxLon
	);

	const isValid: boolean = (
		isArrayLengthValid
		&& areAllNumbers
		&& areCoordinatesInBounds
	);
	// Operation layer end

	// Return
	return isValid;
}
```

### Prefer object parameters

Pass several related inputs as **one object** annotated with **`interface`/`type`** declared under **`./src/types/**`** (see **Types and interfaces architecture**). The split below mirrors production layout.

```ts
// file: ./src/types/db/concurrency-batch-types.ts (exports params plus output discriminator)
