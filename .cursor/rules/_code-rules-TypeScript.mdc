} from "@types-internal/migrations/db-migrations-types";

import {
	DB_MIGRATIONS_PATH_DIR,
	DB_MIGRATIONS_VERSIONS,
} from "@config/migrations/load-order";


async function setMigrations(
): Promise<void> {
	const dbMigrations: DbMigration[] = [];

	for (
		let versionIndex: number = 0;
		versionIndex < DB_MIGRATIONS_VERSIONS.length;
		versionIndex++
	) {
