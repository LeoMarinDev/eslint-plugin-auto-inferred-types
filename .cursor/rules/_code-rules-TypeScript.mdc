### Return defined variables

**Every `return`** names **one identifier** after **`const`/`let`** assignment (**Function Structure**). **Never `return expression`** (including **`return await fetch(…)`**, **`return foo()`**, **`return a + b`**, or **`return condition ? x : y`**). **Early exits** and **`switch`** branches may **`return`** different identifiers at different sites as long as each **`return`** uses this form. **Every `throw`** follows the same rule: **`throw` only** a **`const`-bound `Error` identifier** (never **`throw new Error(…)`** inline). See **Error handling with `try…catch`**.

## Asynchronous Programming

### Use `async` and `await`

**Never** use `.then()` or raw callbacks.
The `async`/`await` syntax keeps your code clean and easy to follow:

**Callee-owned normalization:** Prefer **not** mutating objects taken from **`params`** (defaults, stringify body, augment headers). **`fetchRequest`** **shallow-copies** **`requestParams`** first so the caller retains the original **`RequestParams`** object. Reserve in-place mutation for APIs that deliberately pass **mutable accumulator** buckets (fields documented as out-parameters), such as appending to **`clauseBucket`** in **`buildWhereValuesClause`** below.

```ts
// file: ./src/types/http/fetch-request-types.ts (exports wrapper + mirrored request knobs)
export interface RequestParams {
	method: string;
	headers?: HeadersInit;
	queryParams?: Record<string, unknown>;
	body?: unknown;
}

export interface FetchRequestParams {
	url: string;
	requestParams: RequestParams;
}

// file: ./src/http/fetch-request.ts (consumer)
import type {
	FetchRequestParams,
	RequestParams,
} from "@types-internal/http/fetch-request-types";

async function fetchRequest(
	params: FetchRequestParams,
): Promise<Record<string, unknown>> {
	let url: string = params.url;

	const {
		requestParams: requestParamsFromCaller,
	}: FetchRequestParams = params;

	const requestParamsForFetch: RequestParams = {
		...requestParamsFromCaller,
	};

	// Ensure headers has a default value if null or undefined (on the copy only)
	requestParamsForFetch.headers = requestParamsForFetch.headers ?? {
		"Content-Type": "application/json",
	};

	if (
		requestParamsForFetch.body !== undefined
		&& requestParamsForFetch.body !== null
	) {
		requestParamsForFetch.body = JSON.stringify(requestParamsForFetch.body);
	}

	if (
		requestParamsForFetch.queryParams !== undefined
		&& requestParamsForFetch.queryParams !== null
	) {
		const queryParams: string = new URLSearchParams(
			requestParamsForFetch.queryParams as Record<string, string>,
		).toString();

		url = `${url}?${queryParams}`;
	}

	const response: Response = await fetch(
		url,
		requestParamsForFetch as RequestInit,
	);

	const body: Record<string, unknown> = (
		await response.json()
	) as Record<string, unknown>;

	return body;
}
```

**Intentional mutation (out-parameter):** When the contract is to **append** into a caller-provided collection, mutate **only** the documented field (`clauseBucket` here), not unrelated shared state:

```ts
// file: ./src/types/sql/where-values-clause-types.ts
export type SqlQuery = unknown;

export type SqlTag = (
	strings: TemplateStringsArray,
	...values: unknown[]
) => SqlQuery;

export interface WhereClauseBuilderDbAdapter {
	sql: SqlTag;
}

export interface WhereClauseBuilderState {
	dbAdapter: WhereClauseBuilderDbAdapter;
}

export type WhereConditionValue =
	| string
	| number
	| "IS NULL"
	| "IS NOT NULL";

export interface WhereValuesClause {
	state: WhereClauseBuilderState;
	columnNameSql: SqlQuery;
	whereValue: WhereConditionValue;
	columnIsArray?: boolean;
	clauseBucket: SqlQuery[];
}

// file: ./src/sql-builder/build-where-values-clause.ts
import type {
	SqlTag,
	SqlQuery,
	WhereClauseBuilderState,
	WhereConditionValue,
	WhereValuesClause,
} from "@types-internal/sql/where-values-clause-types";

/**
 * Handles special sentinel strings like "IS NULL" and scalar equality.
 *
 * @param {Object} params - The parameters object.
 * @param {WhereClauseBuilderState} params.state - Mutable builder state.
 * @param {SqlQuery} params.columnNameSql - The escaped column name fragment.
 * @param {WhereConditionValue} params.whereValue - The sentinel or scalar for the predicate.
 * @param {SqlQuery[]} params.clauseBucket - The bucket to add the clause to (mutated).
 * @returns {void}
 */
function buildWhereValuesClause(
	params: WhereValuesClause,
): void {
	const {
		state,
		columnNameSql,
		whereValue,
		columnIsArray = false,
		clauseBucket,
	}: WhereValuesClause = params;

	const {
		dbAdapter,
	}: WhereClauseBuilderState = state;
	const {
		sql,
	}: {
		sql: SqlTag;
	} = dbAdapter;

	let clause: SqlQuery | undefined;

	if (
		whereValue === "IS NULL"
	) {
		clause = sql`${columnNameSql} IS NULL`;
	} else if (
		whereValue === "IS NOT NULL"
	) {
		clause = sql`${columnNameSql} IS NOT NULL`;
	} else if (
		columnIsArray === false
	) {
		clause = sql`${columnNameSql} = ${whereValue}`;
	}

	if (
		clause !== undefined
	) {
		clauseBucket.push(clause);
	}
}
```

### Error handling with `try...catch`

Wrap potentially failing operations in `try...catch` blocks. Follow **Function Structure**: **never** inline **`new Error(…)`** at **`throw`**-assign to a **`const`**, then **`throw`** that name (including the **`default`** branch of a **`switch`** and **`catch`** rewraps with **`cause`**).

```ts
// file: ./src/types/dynamic-sql/demo-db-fetch-try-flow-types.ts
import type {
	DbFetchDataReturnType,
} from "@types-internal/dynamic-sql/db-fetch-rows";

export interface DemoDbFetchTryFlowParams {
	dbAdapter: unknown;
	fetchColumnsParams: unknown;
	columnsSchema: unknown;
	bbox: unknown;
	orderByParams: unknown;
	limitParams: unknown;
	schemaName: string;
	tableName: string;
	returnType: DbFetchDataReturnType;
}

// file: `./src/handlers/demo-db-fetch-try-flow.ts`
// Add imports for `DbFetchDataRows`, `QueryFragments`, `SqlQuery`, `SqlRows`, row shapes, converters,
// `buildQueryFragments`, `buildSelectQuery`, and your tagged `sql` executor from `./src/types/**`,
// `./src/config/**`, and sibling modules-the same way as a full fetch handler (see **Object Destructuring**).

import type {
	DbFetchDataRows,
} from "@types-internal/dynamic-sql/db-fetch-rows";

import type {
	DemoDbFetchTryFlowParams,
} from "@types-internal/dynamic-sql/demo-db-fetch-try-flow-types";

async function demoDbFetchTryFlow(
	params: DemoDbFetchTryFlowParams,
): Promise<DbFetchDataRows> {
	const {
		dbAdapter,
		fetchColumnsParams,
		columnsSchema,
		bbox,
		orderByParams,
		limitParams,
		schemaName,
		tableName,
		returnType,
	} = params;

	try {
		const queryFragments: QueryFragments = buildQueryFragments({
			dbAdapter,
			fetchColumnsParams,
			columnsSchema,
			bbox,
			orderByParams,
			limitParams,
		});

		const selectQuery: SqlQuery = buildSelectQuery({
			dbAdapter,
			schemaName,
			tableName,
			fragments: queryFragments,
		});

		const rows: SqlRows = await sql`${selectQuery}`;

		const rowsArray: RowsArray = rows.values()
			.toArray() as RowsArray;

		switch (returnType) {
			case "mapSerialized": {
				const rowsByIdMapSerialized: RowsByIdMapSerialized = convertRowsToMapIdSerialized(
					rowsArray,
				);
				return rowsByIdMapSerialized;
			}
			case "map": {
				const rowsByIdMap: RowsByIdMap = convertRowsToMapId(
					rowsArray,
				);
				return rowsByIdMap;
			}
			case "array": {
				return rowsArray;
			}
			case "object": {
				const rowsById: RowsById = convertRowsToObjectId(
					rowsArray,
				);
				return rowsById;
			}
			default: {
				const unknownReturnTypeError: Error = new Error(
					"Unknown Return Type for Rows",
				);
				throw unknownReturnTypeError;
			}
		}
	} catch (error) {
		const cause: Error = (
			error instanceof Error
				? error
				: new Error(String(error))
		);
		const fetchRowsError: Error = new Error(
			`Error fetching rows from ${tableName}`,
			{
				cause,
			},
		);
		throw fetchRowsError;
	}
}
```

