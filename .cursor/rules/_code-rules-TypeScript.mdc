### Avoiding Callback Hell

Organize code into smaller asynchronous functions and use `async/await` throughout. This prevents deeply nested callbacks:
```ts
import {
	setTimeout,
} from "node:timers/promises";

// file: ./src/config/network/fetch-timeouts.ts
export const DEFAULT_FETCH_TIMEOUT_MS: number = 500;
export const TIMEOUT_RESULT_SIGNAL_CODE: number = 1;

// file: ./src/types/network/timeout-fetch-types.ts
export interface TimeoutResult {
	code: number;
	message: string;
}

export interface TimeoutHandleParams {
	timeout: number;
}

export interface FetchWithTimeoutParams {
	url: string;
	timeout?: number;
}

// file: `./src/network/fetch-with-timeout.ts`
import type {
	FetchWithTimeoutParams,
	TimeoutHandleParams,
	TimeoutResult,
} from "@types-internal/network/timeout-fetch-types";

import {
	DEFAULT_FETCH_TIMEOUT_MS,
	TIMEOUT_RESULT_SIGNAL_CODE,
} from "@config/network/fetch-timeouts";

/**
 * Completes after a specified timeout with a TimeoutResult payload.
 */
async function timeoutHandle(
	params: TimeoutHandleParams,
): Promise<TimeoutResult> {
	const {
		timeout,
	}: TimeoutHandleParams = params;

	await setTimeout(
		timeout,
		undefined,
		{
			signal: undefined,
		},
	);
	const timeoutReached: TimeoutResult = {
		code: TIMEOUT_RESULT_SIGNAL_CODE,
		message: "Request timed out",
	};
	return timeoutReached;
}


/**
 * Fetch with a timeout using Promise.race.
 */
async function fetchWithTimeout(
	params: FetchWithTimeoutParams,
): Promise<Response | TimeoutResult> {
	const {
		url,
		timeout = DEFAULT_FETCH_TIMEOUT_MS,
	}: FetchWithTimeoutParams = params;
	const timeoutPromise: Promise<TimeoutResult> = timeoutHandle({
		timeout,
	});
	const fetchPromise: Promise<Response> = fetch(
		url,
	);

	const result: Response | TimeoutResult = await Promise.race([
		fetchPromise,
		timeoutPromise,
	]);
	return result;
}
```

